---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getBlogPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'JAEKWANG97',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="BACKEND · DATA · AI"
    title="JAEKWANG97"
    subtitle="백엔드와 데이터 엔지니어링을 공부하고, AI와 오픈소스를 활용하며 배운 것을 기록합니다."
    callToAction={{ text: '전체 글 보기', href: getBlogPermalink(), icon: 'tabler:arrow-right' }}
    callToAction2={{
      text: 'GitHub',
      href: 'https://github.com/jaekwang97',
      target: '_blank',
      icon: 'tabler:brand-github',
    }}
  />

  <BlogLatestPosts
    title="최근 글"
    information="문제를 해결하며 이해한 구조와 판단의 근거를 정리합니다."
    linkText="전체 글 보기"
    count={6}
  />
</Layout>
