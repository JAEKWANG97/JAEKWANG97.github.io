---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

const topicCards = [
  {
    title: "백엔드 / CS",
    desc: "서비스 구조, API, 보안, Java 기반 문제 해결을 기록합니다.",
    tag: "backend",
  },
  {
    title: "오픈소스 기여",
    desc: "코드베이스를 읽고 PR을 준비하며 배운 판단 기준을 남깁니다.",
    tag: "open-source",
  },
  {
    title: "AI 활용 / 생산성",
    desc: "AI를 사고 보조 도구와 개인 작업 시스템으로 쓰는 방법을 실험합니다.",
    tag: "ai",
  },
  {
    title: "커리어 / 회고",
    desc: "주니어 개발자로 성장하며 쌓은 학습, 협업, 회고를 정리합니다.",
    tag: "career",
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-8">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-accent mb-3 text-sm font-medium tracking-wide">
            Backend · AI · Open Source
          </p>
          <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
            JAEKWANG97
          </h1>
        </div>
        <a
          target="_blank"
          href={getRelativeLocaleUrl(locale, "rss.xml")}
          class="mt-2 inline-block"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>

      <p class="mt-5 max-w-2xl leading-7 text-pretty">
        백엔드와 AI를 공부하고 오픈소스에 기여하며 배운 내용을 기록합니다. 문제를
        해결하면서 이해한 구조와 CS 개념, 시행착오를 차근차근 정리합니다.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <section id="topics" class="border-border border-b py-10">
      <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-accent mb-2 text-sm font-medium tracking-wide">
            Topic Navigation
          </p>
          <h2 class="text-2xl font-semibold tracking-wide">주제별 보기</h2>
        </div>
        <a
          href={getRelativeLocaleUrl(locale, "tags")}
          class="text-muted-foreground hover:text-accent text-sm underline decoration-dashed underline-offset-4"
        >
          전체 태그 보기
        </a>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          topicCards.map(topic => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, `tags/${topic.tag}`)}
                class="border-border hover:border-accent hover:bg-card block h-full rounded-xl border p-5 transition-colors"
              >
                <h3 class="text-lg font-semibold">{topic.title}</h3>
                <p class="text-muted-foreground mt-3 text-sm leading-6">
                  {topic.desc}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
