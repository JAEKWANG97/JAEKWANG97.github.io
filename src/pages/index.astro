---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import EditorialPost from "@/components/EditorialPost.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { CATEGORIES, getCategoryPosts } from "@/utils/categories";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const sortedPosts = getSortedPosts(await getCollection("posts"));
const leadPost = sortedPosts[0];
const homePath = getRelativeLocaleUrl(locale, "");
const categorySections = CATEGORIES.map(category => ({
  ...category,
  posts: getCategoryPosts(sortedPosts, category.slug).slice(0, 3),
})).filter(category => category.posts.length > 0);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-10">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p
            class="text-accent mb-3 text-xs font-semibold tracking-[0.22em] uppercase"
          >
            Work in progress · Issue 01
          </p>
          <h1
            class="max-w-2xl text-3xl leading-tight font-bold tracking-tight text-balance sm:text-5xl"
          >
            만들고, 막히고, 다시 이해한 것들
          </h1>
        </div>
        <a
          target="_blank"
          href={getRelativeLocaleUrl(locale, "rss.xml")}
          class="mt-2 inline-block"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>
      <p class="mt-5 max-w-2xl leading-7 text-pretty">
        결과보다 그 결과에 도달한 과정을 기록합니다. 프로젝트를 만들며 내린
        선택, 문제를 좁혀간 근거, 인턴으로 배운 일하는 방식, 오픈소스에서 읽은
        코드의 문맥을 한곳에 모았습니다.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      leadPost && (
        <section class="border-border border-b py-10">
          <div class="mb-6 flex items-center justify-between gap-4">
            <div>
              <p class="text-accent text-xs font-semibold tracking-[0.2em] uppercase">
                Editor's pick
              </p>
              <h2 class="mt-2 text-xl font-semibold">이번에 주목할 글</h2>
            </div>
            <span class="text-muted-foreground hidden text-xs tracking-[0.15em] uppercase sm:block">
              JAEKWANG97 JOURNAL
            </span>
          </div>
          <EditorialPost post={leadPost} prominent coverLabel="FEATURE" />
        </section>
      )
    }

    <section id="categories" class="py-4">
      {
        categorySections.map((category, index) => (
          <section class="border-border border-b py-10 last:border-b-0">
            <header class="mb-7 grid gap-3 sm:grid-cols-[8rem_1fr_auto] sm:items-end">
              <p class="text-accent text-xs font-semibold tracking-[0.2em] uppercase">
                {String(index + 1).padStart(2, "0")} · {category.eyebrow}
              </p>
              <div>
                <h2 class="text-2xl font-semibold tracking-tight">
                  {category.name}
                </h2>
                <p class="text-muted-foreground mt-2 max-w-xl text-sm leading-6">
                  {category.description}
                </p>
              </div>
              <a
                href={getRelativeLocaleUrl(
                  locale,
                  `categories/${category.slug}`
                )}
                class="text-accent text-sm font-medium underline decoration-dashed underline-offset-4"
              >
                모두 보기 →
              </a>
            </header>

            <div class="grid gap-8 lg:grid-cols-[1.35fr_1fr]">
              {category.posts[0] && (
                <EditorialPost
                  post={category.posts[0]}
                  prominent
                  showCover={false}
                  coverLabel={category.eyebrow}
                />
              )}
              <div class="border-border divide-border divide-y border-t lg:border-t-0">
                {category.posts.slice(1).map(post => (
                  <div class="py-5 first:pt-0 lg:first:pt-0">
                    <EditorialPost post={post} />
                  </div>
                ))}
              </div>
            </div>
          </section>
        ))
      }
    </section>

    <div class="my-10 flex flex-wrap justify-center gap-4 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "categories")}>
        카테고리 둘러보기 <IconArrowRight
          class="inline-block rtl:-rotate-180"
        />
      </LinkButton>
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}
        >전체 글 보기</LinkButton
      >
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
