---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ConceptPost from "@/components/ConceptPost.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { CATEGORIES, getCategoryPosts } from "@/utils/categories";
import config from "@/config";

export const getStaticPaths = (() =>
  [
    {
      slug: "original-plus",
      number: "01",
      title: "AstroPaper Plus",
      note: "원형 유지 · 가장 안전한 변화",
    },
    {
      slug: "quiet-editorial",
      number: "02",
      title: "조용한 에디토리얼",
      note: "여백과 타이포그래피 중심",
    },
    {
      slug: "developer-index",
      number: "03",
      title: "개발자 인덱스",
      note: "빠른 탐색과 높은 정보 밀도",
    },
    {
      slug: "soft-cards",
      number: "04",
      title: "소프트 카드",
      note: "부드러운 색면과 명확한 구획",
    },
    {
      slug: "work-notes",
      number: "05",
      title: "작업 노트",
      note: "과정과 시간의 흐름 중심",
    },
    {
      slug: "case-study",
      number: "06",
      title: "케이스 스터디",
      note: "포트폴리오와 판단 근거 중심",
    },
    {
      slug: "korean-essay",
      number: "07",
      title: "한국어 에세이",
      note: "개인 기록의 온도와 긴 호흡",
    },
  ].map(concept => ({
    params: { concept: concept.slug },
    props: { concept },
  }))) satisfies GetStaticPaths;

const { concept } = Astro.props;
const posts = getSortedPosts(await getCollection("posts"));
const lead = posts[0];
const categoryGroups = CATEGORIES.map(category => ({
  ...category,
  posts: getCategoryPosts(posts, category.slug),
})).filter(group => group.posts.length);
const categoryName = (slug: string) =>
  CATEGORIES.find(category => category.slug === slug)?.name ?? slug;
---

<Layout title={`${concept.number} ${concept.title} | ${config.site.title}`}>
  <Header />
  <main
    id="main-content"
    class:list={["app-layout pb-12", `concept-${concept.slug}`]}
  >
    <nav
      class="border-border flex items-center justify-between border-b py-3 text-xs"
    >
      <a href="/designs/" class="text-muted-foreground hover:text-accent"
        >← 시안 목록</a
      >
      <span class="text-right"
        ><strong class="text-accent">{concept.number}</strong> / 07<span
          class="hidden sm:inline"
        >
          · {concept.note}</span
        ></span
      >
    </nav>

    {
      concept.slug === "original-plus" && (
        <>
          <section class="border-border border-b py-10">
            <p class="text-accent text-sm font-medium">
              Backend · AI · Open Source
            </p>
            <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
              JAEKWANG97
            </h1>
            <p class="mt-5 max-w-2xl leading-7">
              백엔드와 AI를 공부하고 오픈소스에 기여하며 배운 내용을 기록합니다.
              결과보다 문제를 이해하고 검증한 과정을 남깁니다.
            </p>
            <div class="mt-7 flex flex-wrap gap-2">
              {CATEGORIES.map(category => (
                <a
                  href={`/categories/${category.slug}/`}
                  class="border-border hover:border-accent rounded-full border px-4 py-2 text-sm"
                >
                  {category.name}
                </a>
              ))}
            </div>
          </section>
          <section class="py-10">
            <h2 class="mb-6 text-2xl font-semibold">최근 글</h2>
            <div class="divide-border divide-y">
              {posts.slice(0, 7).map((post, index) => (
                <div class="py-5">
                  <ConceptPost {post} number={index + 1} compact />
                </div>
              ))}
            </div>
          </section>
        </>
      )
    }

    {
      concept.slug === "quiet-editorial" && (
        <>
          <section class="border-border border-b pt-14 pb-12 sm:pt-20 sm:pb-16">
            <p class="text-muted-foreground text-sm">재광의 개발 기록</p>
            <h1 class="mt-5 max-w-2xl text-4xl leading-tight font-semibold tracking-[-0.04em] text-balance sm:text-6xl">
              일하면서 생긴 질문을 오래 들여다봅니다.
            </h1>
            <p class="mt-7 max-w-xl leading-8">
              만든 것보다 왜 그렇게 만들었는지, 해결한 답보다 어떤 근거로
              좁혀갔는지를 씁니다.
            </p>
          </section>
          {lead && (
            <section class="border-border grid gap-7 border-b py-12 sm:grid-cols-[1fr_2fr]">
              <p class="text-accent text-sm">최근 기록</p>
              <ConceptPost post={lead} />
            </section>
          )}
          <section>
            {categoryGroups.map(group => (
              <div class="border-border grid gap-5 border-b py-9 sm:grid-cols-[1fr_2fr]">
                <div>
                  <h2 class="text-xl font-semibold">{group.name}</h2>
                  <p class="text-muted-foreground mt-2 text-sm leading-6">
                    {group.description}
                  </p>
                </div>
                <div class="space-y-7">
                  {group.posts.slice(0, 2).map(post => (
                    <ConceptPost {post} compact />
                  ))}
                </div>
              </div>
            ))}
          </section>
        </>
      )
    }

    {
      concept.slug === "developer-index" && (
        <>
          <section class="border-border border-b py-8">
            <div class="flex flex-wrap items-end justify-between gap-5">
              <>
                <div>
                  <>
                    <p class="text-accent font-mono text-xs">
                      ~/jaekwang97/notes
                    </p>
                    <h1 class="mt-2 font-mono text-3xl font-bold">
                      Developer Index
                    </h1>
                  </>
                </div>
                <p class="text-muted-foreground font-mono text-xs">
                  {posts.length} public entries
                </p>
              </>
            </div>
            <div class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-lg bg-[var(--color-border)] sm:grid-cols-4">
              {CATEGORIES.map(category => (
                <a
                  href={`/categories/${category.slug}/`}
                  class="bg-background hover:bg-card p-4 font-mono text-sm"
                >
                  <span class="text-accent">/</span>
                  {category.name}
                </a>
              ))}
            </div>
          </section>
          <section class="py-4 font-mono">
            <div class="text-muted-foreground grid grid-cols-[3rem_1fr_6rem] gap-3 border-b py-3 text-xs">
              <>
                <span>#</span>
                <span>TITLE</span>
                <span>CATEGORY</span>
              </>
            </div>
            {posts.slice(0, 12).map((post, index) => (
              <a
                href={`/posts/${post.id}/`}
                class="border-border hover:text-accent grid grid-cols-[3rem_1fr_6rem] gap-3 border-b py-4 text-sm"
              >
                <span class="text-muted-foreground">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>{post.data.title}</span>
                <span class="text-muted-foreground text-xs">
                  {categoryName(post.data.category)}
                </span>
              </a>
            ))}
          </section>
        </>
      )
    }

    {
      concept.slug === "soft-cards" && (
        <>
          <section class="py-12 text-center">
            <>
              <p class="text-accent text-sm font-medium">JAEKWANG97</p>
              <h1 class="mx-auto mt-4 max-w-2xl text-4xl font-bold tracking-tight text-balance">
                경험을 쌓고, 이해한 것을 나눕니다.
              </h1>
              <p class="text-muted-foreground mx-auto mt-5 max-w-xl leading-7">
                프로젝트, 문제 해결, 인턴, 오픈소스 경험을 편안하게 둘러보세요.
              </p>
            </>
          </section>
          <section class="grid gap-4 sm:grid-cols-2">
            {categoryGroups.map((group, index) => (
              <a
                href={`/categories/${group.slug}/`}
                class:list={[
                  "border-border group rounded-2xl border p-6 transition-transform hover:-translate-y-1",
                  index % 2 ? "bg-card" : "bg-accent/5",
                ]}
              >
                <span class="text-accent text-xs font-semibold">
                  0{index + 1}
                </span>
                <h2 class="mt-8 text-2xl font-semibold">{group.name}</h2>
                <p class="text-muted-foreground mt-3 text-sm leading-6">
                  {group.description}
                </p>
                <p class="mt-6 text-sm font-medium">
                  {group.posts.length}개의 글 →
                </p>
              </a>
            ))}
          </section>
          <section class="py-12">
            <>
              <h2 class="mb-6 text-xl font-semibold">새로 쓴 글</h2>
              <div class="grid gap-5 sm:grid-cols-2">
                {posts.slice(0, 4).map(post => (
                  <div class="border-border rounded-xl border p-5">
                    <ConceptPost {post} compact />
                  </div>
                ))}
              </div>
            </>
          </section>
        </>
      )
    }

    {
      concept.slug === "work-notes" && (
        <>
          <section class="border-border border-b py-10">
            <>
              <p class="text-accent text-sm">WORK LOG</p>
              <h1 class="mt-3 text-4xl font-bold">진행 중인 생각과 작업</h1>
              <p class="text-muted-foreground mt-4 max-w-xl leading-7">
                완성된 결론보다, 일을 하며 판단이 바뀐 순간을 시간순으로
                기록합니다.
              </p>
            </>
          </section>
          <section class="relative py-8 before:absolute before:top-8 before:bottom-8 before:left-[4.4rem] before:w-px before:bg-[var(--color-border)]">
            {posts.slice(0, 9).map((post, index) => (
              <div class="relative grid grid-cols-[3.5rem_1fr] gap-8 py-5">
                <span class="text-muted-foreground text-xs">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="bg-accent absolute top-7 left-[4.15rem] size-2 rounded-full" />
                <ConceptPost {post} compact />
              </div>
            ))}
          </section>
        </>
      )
    }

    {
      concept.slug === "case-study" && (
        <>
          <section class="border-border border-b py-12">
            <>
              <p class="text-accent text-sm font-semibold">SELECTED WORK</p>
              <h1 class="mt-4 max-w-xl text-4xl font-bold tracking-tight sm:text-5xl">
                문제를 이해하고 끝까지 검증한 경험
              </h1>
              <p class="text-muted-foreground mt-5 max-w-xl leading-7">
                프로젝트의 결과보다 제약, 선택, 검증을 중심으로 정리한 개발
                사례입니다.
              </p>
            </>
          </section>
          <section class="grid gap-5 py-8">
            {posts.slice(0, 5).map((post, index) => (
              <article class="border-border grid gap-6 rounded-xl border p-6 sm:grid-cols-[7rem_1fr_auto] sm:items-center">
                <div>
                  <span class="text-accent text-xs font-semibold">
                    CASE {String(index + 1).padStart(2, "0")}
                  </span>
                  <p class="text-muted-foreground mt-2 text-xs">
                    {categoryName(post.data.category)}
                  </p>
                </div>
                <ConceptPost {post} compact />
                <a
                  href={`/posts/${post.id}/`}
                  class="text-accent text-sm font-medium"
                >
                  자세히 →
                </a>
              </article>
            ))}
          </section>
        </>
      )
    }

    {
      concept.slug === "korean-essay" && (
        <>
          <section class="border-border border-b py-14 text-center sm:py-20">
            <>
              <p class="text-muted-foreground text-sm">재광의 기록</p>
              <h1 class="mx-auto mt-6 max-w-2xl font-serif text-4xl leading-snug font-semibold text-balance sm:text-6xl">
                배우는 동안 놓치고 싶지 않은 장면들
              </h1>
              <p class="mx-auto mt-8 max-w-xl font-serif text-lg leading-9">
                일을 하다 보면 기술보다 오래 남는 질문이 있습니다. 왜 지금
                이렇게 일하는지, 무엇을 지키며 바꿔야 하는지 천천히 적습니다.
              </p>
            </>
          </section>
          {lead && (
            <section class="border-border border-b py-12 text-center">
              <p class="text-accent text-sm">새로 쓴 이야기</p>
              <div class="mx-auto mt-6 max-w-xl">
                <ConceptPost post={lead} />
              </div>
            </section>
          )}
          <section class="grid gap-x-10 gap-y-8 py-12 sm:grid-cols-2">
            {posts.slice(1, 7).map(post => (
              <div class="border-border border-t pt-6">
                <ConceptPost {post} compact />
              </div>
            ))}
          </section>
        </>
      )
    }
  </main>
  <Footer />
</Layout>
