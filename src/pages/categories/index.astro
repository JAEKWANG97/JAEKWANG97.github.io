---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { CATEGORIES, getCategoryPosts } from "@/utils/categories";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts", ({ data }) => !data.draft);
const categories = CATEGORIES.map(category => ({
  ...category,
  count: getCategoryPosts(posts, category.slug).length,
}));
---

<Layout title={`카테고리 | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="카테고리"
    pageDesc="기술 이름보다, 실제로 어떤 일을 하며 배웠는지에 따라 글을 나눴습니다."
  >
    <ol class="grid gap-5 sm:grid-cols-2">
      {
        categories.map((category, index) => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `categories/${category.slug}`)}
              class="border-border hover:border-accent group flex h-full flex-col rounded-2xl border p-6 transition-colors"
            >
              <div class="flex items-start justify-between gap-3">
                <p class="text-accent text-xs font-semibold tracking-[0.2em] uppercase">
                  {String(index + 1).padStart(2, "0")} · {category.eyebrow}
                </p>
                <span class="text-muted-foreground text-sm">
                  {category.count}편
                </span>
              </div>
              <h2 class="group-hover:text-accent mt-7 text-2xl font-semibold transition-colors">
                {category.name}
              </h2>
              <p class="text-muted-foreground mt-3 text-sm leading-6">
                {category.description}
              </p>
              <span class="text-accent mt-auto pt-7 text-sm font-medium">
                글 모아보기 →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </Main>
  <Footer />
</Layout>
