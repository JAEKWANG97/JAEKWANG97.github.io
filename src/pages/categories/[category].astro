---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import EditorialPost from "@/components/EditorialPost.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { CATEGORIES, getCategoryPosts } from "@/utils/categories";
import config from "@/config";

export const getStaticPaths = (async () =>
  CATEGORIES.map(category => ({
    params: { category: category.slug },
    props: { category },
  }))) satisfies GetStaticPaths;

const { category } = Astro.props;
const posts = getCategoryPosts(
  getSortedPosts(await getCollection("posts")),
  category.slug
);
---

<Layout title={`${category.name} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={category.name} pageDesc={category.description}>
    <p
      class="text-accent mb-8 text-xs font-semibold tracking-[0.2em] uppercase"
    >
      {category.eyebrow} · {posts.length} STORIES
    </p>
    {
      posts[0] && (
        <section class="border-border mb-6 border-b pb-9">
          <EditorialPost
            post={posts[0]}
            prominent
            categoryName="대표 글"
            coverLabel={category.eyebrow}
          />
        </section>
      )
    }
    <ol class="divide-border divide-y">
      {
        posts.slice(1).map((post, index) => (
          <li class="grid gap-4 py-7 sm:grid-cols-[3rem_1fr]">
            <span class="text-muted-foreground pt-1 text-sm">
              {String(index + 2).padStart(2, "0")}
            </span>
            <EditorialPost post={post} />
          </li>
        ))
      }
    </ol>
  </Main>
  <Footer />
</Layout>
