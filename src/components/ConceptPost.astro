---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import Datetime from "@/components/Datetime.astro";

type Props = {
  post: CollectionEntry<"posts">;
  number?: number;
  compact?: boolean;
  showDescription?: boolean;
};

const { post, number, compact = false, showDescription = true } = Astro.props;
---

<article class="group">
  <div class="flex gap-4">
    {
      number && (
        <span class="text-muted-foreground pt-1 text-xs tabular-nums">
          {String(number).padStart(2, "0")}
        </span>
      )
    }
    <div class="min-w-0">
      <a href={getPostUrl(post.id, post.filePath, Astro.currentLocale)}>
        <h3
          class:list={[
            "group-hover:text-accent font-semibold text-balance transition-colors",
            compact ? "text-base" : "text-xl leading-snug",
          ]}
        >
          {post.data.title}
        </h3>
      </a>
      <Datetime class="mt-2" {...post.data} />
      {
        showDescription && (
          <p
            class:list={[
              "text-muted-foreground mt-2 leading-6",
              compact ? "line-clamp-2 text-sm" : "text-sm",
            ]}
          >
            {post.data.description}
          </p>
        )
      }
    </div>
  </div>
</article>
