<script>
  async function renderMermaidBlocks() {
    const mermaidBlocks = Array.from(
      document.querySelectorAll('pre[data-language="mermaid"] > code, pre > code.language-mermaid')
    );

    if (mermaidBlocks.length === 0) return;

    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: document.documentElement.classList.contains('dark') ? 'dark' : 'base',
    });

    for (const [index, block] of mermaidBlocks.entries()) {
      const source = block.textContent?.trim();
      const pre = block.parentElement;
      if (!source || !pre || pre.dataset.mermaidRendered === 'true') continue;

      const container = document.createElement('div');
      container.className = 'mermaid-diagram';
      container.setAttribute('aria-label', 'Mermaid diagram');

      try {
        const id = `mermaid-${index}-${Math.random().toString(36).slice(2)}`;
        const { svg } = await mermaid.render(id, source);
        container.innerHTML = svg;
        pre.replaceWith(container);
      } catch {
        pre.dataset.mermaidRendered = 'true';
        pre.classList.add('mermaid-error');
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      renderMermaidBlocks();
    });
  } else {
    renderMermaidBlocks();
  }

  document.addEventListener('astro:page-load', () => {
    renderMermaidBlocks();
  });
</script>

<style is:global>
  .mermaid-diagram {
    margin: 1.5rem 0;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-muted);
    padding: 1rem;
  }

  .mermaid-diagram svg {
    max-width: 100%;
    height: auto;
  }

  pre.mermaid-error {
    border-color: color-mix(in oklab, var(--color-accent) 60%, transparent);
  }
</style>
