---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import Datetime from "./Datetime.astro";

type Props = {
  post: CollectionEntry<"posts">;
  categoryName?: string;
  coverLabel?: string;
  prominent?: boolean;
  showCover?: boolean;
};

const {
  post,
  categoryName,
  coverLabel,
  prominent = false,
  showCover = true,
} = Astro.props;
const { id, filePath, data } = post;
---

<article
  class:list={[
    "group h-full",
    {
      "grid gap-6 sm:grid-cols-[minmax(0,1fr)_11rem] sm:items-center":
        prominent,
    },
  ]}
>
  <div class:list={{ "sm:py-2": prominent }}>
    {
      categoryName && (
        <p class="text-accent mb-3 text-xs font-semibold tracking-[0.18em] uppercase">
          {categoryName}
        </p>
      )
    }
    <a href={getPostUrl(id, filePath, Astro.currentLocale)} class="block">
      <h3
        class:list={[
          "group-hover:text-accent font-semibold text-balance transition-colors",
          prominent
            ? "text-2xl leading-tight sm:text-3xl"
            : "text-lg leading-snug",
        ]}
      >
        {data.title}
      </h3>
    </a>
    <Datetime class="mt-3" {...data} />
    <p
      class:list={[
        "text-muted-foreground mt-3 leading-6",
        prominent ? "text-base" : "line-clamp-2 text-sm",
      ]}
    >
      {data.description}
    </p>
  </div>

  {
    prominent && showCover && (
      <a
        href={getPostUrl(id, filePath, Astro.currentLocale)}
        aria-label={`${data.title} 읽기`}
        class="border-border bg-card relative hidden aspect-[4/3] overflow-hidden rounded-2xl border sm:block"
      >
        <span class="text-accent/10 absolute -right-3 -bottom-7 text-8xl font-black select-none">
          {coverLabel?.slice(0, 1) ?? "J"}
        </span>
        <span class="text-muted-foreground absolute top-4 left-4 text-[0.65rem] font-semibold tracking-[0.2em] uppercase">
          {coverLabel ?? "JOURNAL"}
        </span>
        <span class="bg-accent absolute bottom-5 left-4 h-0.5 w-10" />
      </a>
    )
  }
</article>
